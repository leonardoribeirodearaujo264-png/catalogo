# Copie para .env.local e preencha com as credenciais do seu projeto
# Supabase (Project Settings > API). Sem elas o app não sobe: toda a
# autenticação e todos os dados das lojas dependem do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site, usada nos metadados de compartilhamento (Open Graph).
# Em produção, algo como https://carselect.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
